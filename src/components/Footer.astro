---
import '../styles/global.css';
import testSocial from '../assets/favicon.svg';
---

<footer>
    <p class="created-by">Made by freezeH2O</p>
    <div class="socials">
        <a class="social-link" href="https://www.youtube.com/" target="_blank"><img src={testSocial.src}></a>
        <a class="social-link" href="https://www.youtube.com/" target="_blank"><img src={testSocial.src}></a>
        <a class="social-link" href="https://www.youtube.com/" target="_blank"><img src={testSocial.src}></a>
        <a class="social-link" href="https://www.youtube.com/" target="_blank"><img src={testSocial.src}></a>
    </div>
</footer>

<style>
    footer {
        background-color: var(--color-darkest);
        display: flex;
        flex-direction: column-reverse;
        justify-content: center;
        text-align: center;
        align-items: center;
        padding: 20px;
    }

    .created-by {
        color: var(--color-text-muted);
    }

    .socials {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .social-link {
        width: 50px;
        height: 50px;
    }

    .social-link:hover {
        background-color: var(--color-surface);
    }

    .social-link img {
        width: 100%;
    }

    @media (min-width: 768px) {
        footer {
            flex-direction: row;
            justify-content: space-between;
        }
    }
</style>