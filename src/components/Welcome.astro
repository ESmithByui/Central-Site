---
import background from '../assets/mc-image.png';
---

<div id="container">
	<img id="background" src={background.src} alt="" fetchpriority="high" />
	<main>

	</main>
</div>

<style>
	#background {
		position: fixed;
		inset: -20px;
		width: calc(100% + 40px);
    	height: calc(100% + 40px);
		z-index: -1;
		filter: blur(10px);
		object-fit: cover;
	}

	main {
		background-color: var(--color-background);
		min-height: calc(100vh - 140.4px - 98px);
		background-color: color-mix(
        in srgb,
        var(--color-background) 85%,
        transparent
		);
	}

	@media (min-width: 768px) {
        main {
            min-height: calc(100vh - 89.81px - 99px);
			max-width: 1000px;
			margin: 0 auto;
		}
    }
	
</style>
