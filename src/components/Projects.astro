---
import '../styles/global.css';
import gameState from '../assets/game-state.webp';
import centralSite from '../assets/site-logo.svg';
---

<div id="projects-page">
    <div id="project-gallery">
        <div class="project">
            <a class="project-link" href="https://esmithbyui.github.io/wdd131/GameState/">
                <div class="project-tab">
                    <div class="project-upper GameState">
                        <img class="project-img" src={gameState.src}>
                        <p class="project-title">GameState</p>
                    </div>
                    <p class="project-desc">Lorem Ipsum</p>
                </div>
            </a>
        </div>
        <div class="project">
            <a class="project-link" href="#">
                <div class="project-tab">
                    <div class="project-upper">
                        <img class="project-img" src={centralSite.src}>
                        <p class="project-title">Empty</p>
                    </div>
                    <p class="project-desc">This is currently a placeholder for future projects.</p>
                </div>
            </a>
        </div>
        <div class="project">
            <a class="project-link" href="#">
                <div class="project-tab">
                    <div class="project-upper">
                        <img class="project-img" src={centralSite.src}>
                        <p class="project-title">GameState</p>
                    </div>
                    <p class="project-desc">This is currently a placeholder for future projects.</p>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    #projects-page {
        background-color: var(--color-background);
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    #project-gallery {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 30px;
        justify-content: center;
        gap:10px
    }

    .project {
        width: 300px;
        background-color: var(--color-surface);
        border-radius: 30px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

    .project:hover {
        transform: scale(1.02);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    }

    .project-link {
        text-decoration: none;
        color: var(--color-text);
    }

    .project-upper {
        display: flex;
        align-items: end;
        gap: 10px;
        background-color: var(--color-darkest);
        padding: 20px;
        border-radius: 30px 30px 0 0;
    }

    .project-img {
        background-color: var(--color-darkest);
        width: 50px;
        border-radius: 20px;
        padding: 10px;
    }

    .project-title {
        margin: 0;
        font-size: 40px;
    }

    .project-desc {
        padding: 20px;
        margin: 0;
        height: 100px;
    }

    .GameState {
        background-color: #1b1f3b;
        color: #ffffff;
    }

    @media (min-width: 768px) {
        #project-gallery {
            max-width: 1000px;
            flex-direction: row;
            flex-wrap: wrap;
        }
    }
</style>