---
import '../styles/global.css';
import siteLogo from '../assets/site-logo.svg';
import hamburgerMenu from '../assets/hamburger-menu.svg';
---

<header>
    <div id="mini-header">
        <div id="site-title-block">
            <a class="site-logo-link" href="/">
                <img class="site-logo" src={siteLogo.src} alt="#">
            </a>
            <p class="site-title">
                freeze<span class="special-colors">H2O</span>
            </p>
        </div>
        <button class="nav-button" type="button" aria-label="Toggle Navigation">
            <img src={hamburgerMenu.src} alt="hamburger-menu">
        </button>
    </div>
    <nav id="main-nav">
        <ul id="nav-list">
            <li class="nav-list-item">
                <a class="nav-link" href="/projects">Projects</a>
            </li>
            <li class="nav-list-item">
                <a class="nav-link" href="#">Undetermined</a>
            </li>
            <li class="nav-list-item">
                <a class="nav-link" href="#">Undetermined</a>
            </li>
        </ul>
    </nav>
</header>

<style>
    header {
        position: relative;
        z-index: 100;
        background-color: var(--color-primary);
    }

    #mini-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 5px;
    }

    #site-title-block {
        display: flex;
        align-items: center;
    }

    .site-logo {
        width: 60px;
    }

    .site-title {
        font-size: 25px;
        font-weight: bold;
        color: var(--color-text);
        padding:5px;
    }

    .special-colors {
        background: linear-gradient(145deg, var(--color-secondary), var(--color-accent));
        background-clip: text;
        -webkit-background-clip: text;
        color:transparent;
    }

    .nav-button {
        width: 60px;
        height: 60px;
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
    }

    .nav-button img {
        width: 30px;
        height: 30px;
    }

    img {
        width: 20px;
    }

    #main-nav {
        position: absolute;
        top:100%;
        left: 0;
        width: 100%;

        background-color: var(--color-surface);

        clip-path: inset(0 0 100% 0);
        opacity: 0;
        visibility: hidden;

        transition:
            clip-path 0.3s ease,
            opacity 0.3s ease,
            visibility 0.3s;
    }

    #main-nav.open {
        clip-path: inset(0 0 0 0);
        opacity: 1;
        visibility: visible;
    }

    #nav-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .nav-link {
        display: block;
        padding: 16px 24px;
        color: var(--color-text);
        text-decoration: none;
    }

    .nav-link:hover , .nav-link:focus-visible {
        background-color: var(--color-secondary);
    }

    .nav-list-item:not(:last-child) {
        border-bottom: 1px solid var(--color-accent);
    }

    @media (min-width: 768px) {

        /* Header */
        header {
            display: flex;
            justify-content: space-between;
            align-items: stretch;
        }

        .nav-button {
            display: none;
        }

        /* Navigation Container */
        #main-nav {
            position: static;
            display: flex;
            align-items: stretch;

            width: auto;
            margin-right: 0;

            background-color: transparent;
            clip-path: none;
            opacity: 1;
            visibility: visible;
            transition: none;
        }

        /* Navigation List */
        #nav-list {
            display: flex;
            align-items: stretch;
        }

        /* Navigation Items */
        .nav-list-item {
            position: relative;
            display: flex;
            align-items: stretch;

            margin-left: -15px;
            border: none;
            transform: none;
        }

        .nav-list-item:first-child {
            margin-left: 0;
        }

        .nav-list-item:not(:last-child) {
            border-bottom: none;
        }

        /* Slanted Links */
        .nav-link {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;

            padding: 0 35px;
            color: var(--color-text);

            background-color: transparent;
            transform: none;

            clip-path: polygon(
                15px 0,
                100% 0,
                calc(100% - 15px) 100%,
                0 100%
            );
        }

        /* Slanted Left Borders */
        .nav-list-item::before {
            content: "";
            position: absolute;
            inset: 0;

            background-color: var(--color-accent);

            clip-path: polygon(
                15px 0,
                18px 0,
                3px 100%,
                0 100%
            );

            pointer-events: none;
            z-index: 2;
        }

        /* Hover and Focus */
        .nav-link:hover,
        .nav-link:focus-visible {
            background-color: var(--color-surface);
        }

        /* Final Link - Straight Right Edge */
        .nav-list-item:last-child .nav-link {
            clip-path: polygon(
                15px 0,
                100% 0,
                100% 100%,
                0 100%
            );
        }
    }
    
</style>

<script>
    const menuButton = document.querySelector('.nav-button');
    const navigation = document.querySelector('#main-nav');

    menuButton?.addEventListener('click', () => {
        const isOpen = navigation?.classList.toggle('open') ?? false;
    });

    document.addEventListener('click', (event) => {
    const target = event.target;

    if (!(target instanceof Node)) return;

    if (
        !navigation?.contains(target) &&
        !menuButton?.contains(target)
    ) {
        navigation?.classList.remove('open');
        menuButton?.setAttribute('aria-expanded', 'false');
    }
});
</script>